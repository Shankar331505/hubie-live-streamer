# Copy to .env and fill in. .env is never committed.
GEMINI_API_KEY=
# Google Cloud Text-to-Speech (Chirp 3 HD, free 1M characters a month). Create an API key restricted to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=Puck
KICK_RTMP_URL=
KICK_STREAM_KEY=
KICK_CHANNEL=househubie
KICK_CHATROOM_ID=
# Optional (the older ElevenLabs voice path)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
